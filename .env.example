# Infrastructure
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aura
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Service Databases (database-per-service)
API_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aura_api
CATALOG_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aura_catalog
ASSISTANT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aura_assistant

# Service Endpoints
VISION_SERVICE_URL=http://localhost:8000
ASSISTANT_SERVICE_URL=http://localhost:3002
CATALOG_SERVICE_URL=http://localhost:3003
BFF_URL=http://localhost:3001
