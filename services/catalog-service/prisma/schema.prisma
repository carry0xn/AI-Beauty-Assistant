generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("CATALOG_DATABASE_URL")
}

model User {
  id         String       @id @default(uuid())
  email      String       @unique
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  analyses   Analysis[]
  preference Preference?
}

model Analysis {
  id          String   @id @default(uuid())
  userId      String
  resultJson  Json
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model Product {
  id          String   @id @default(uuid())
  sku         String   @unique
  name        String
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Preference {
  id          String   @id @default(uuid())
  userId      String   @unique
  skinTone    String?
  styleGoal   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}
